# 前端环境变量（Vite）
#
# 前端部署在公网，后端 API 部署在公司内网，两者不同源，
# 因此必须显式指定 API 地址，并让后端把前端域名加入 CORS 白名单
# （LANDRIVE_CORS_ALLOW）。
#
# 复制本文件为 .env.local（或按环境建 .env.development / .env.production）后修改。

# 内网 API 的完整地址（需包含 /api 后缀）。
# 例：http://192.168.1.100:8080/api
# 留空则回退为同源 /api（适用于用反向代理把 /api 转发到内网网关的部署方式）。
VITE_API_BASE_URL=http://192.168.1.100:8080/api

# 接口连通性探测超时（毫秒）。超过该时间视为当前网络无法访问内网，
# 页面会提示「无法在此网络下使用，请更换网络再试！」
VITE_API_PROBE_TIMEOUT=6000
