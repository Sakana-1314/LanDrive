# 局域网文件助手 —— docker compose 环境变量
#
# 用法：
#   cp .env.example .env
#   # 按下面注释填写，带 ★ 的是必填项
#   docker compose up -d
#
# 说明：
#   本文件供 docker-compose.yml 使用。带 :? 的变量若未填写，compose 会直接报错并提示，
#   不会带着空值把容器启动起来。

# ─────────────── 数据库（必填）───────────────
# MySQL 不随本编排部署，请用 1Panel 应用商店安装，或指向已有实例。
# 主机名填 1Panel 中 MySQL 的容器名或服务名（同处 1panel-network 时可直接互通）。
#
# 单机 1Panel 场景示例：
#   LANDRIVE_MYSQL_DSN=lanfs:你的密码@tcp(mysql:3306)/lanfs
# 若 MySQL 不在同一台机器：
#   LANDRIVE_MYSQL_DSN=lanfs:你的密码@tcp(10.0.0.5:3306)/lanfs
LANDRIVE_MYSQL_DSN=

# ─────────────── 安全密钥（必填）───────────────
# 登录凭据签名密钥，至少 32 位。生成方式：openssl rand -hex 32
LANDRIVE_JWT_SECRET=

# 管理员初始密码。仅在首次启动（账号表为空）时用于创建账号；
# 之后修改此项不会影响已存在的账号。
LANDRIVE_ADMIN_PASSWORD=

# ─────────────── 跨域白名单（视部署方式而定）───────────────
# 允许访问接口的网页地址，即用户浏览器里打开的地址。多个地址用英文逗号分隔：
#   https://files.example.com,http://192.168.1.100
#
# 何时需要填：
#   - 网页端用默认的 /api 同源反代 → 浏览器请求与页面同源，不触发跨域，**可留空**；
#   - 网页端跨域直连接口（LANDRIVE_API_PROXY 置空）→ **必填**，
#     填错的后果：浏览器拦截请求，用户看到「无法在此网络下使用，请更换网络再试！」。
LANDRIVE_CORS_ALLOW=

# ─────────────── 接口地址（可选）───────────────
# ★ 推荐：让网页端把同源 /api 反代到后端容器。
#   浏览器只访问一个域名 → 不跨域、不需要配 CORS，后端地址也不暴露给浏览器。
#   值填「容器名:端口」，默认指向本编排的 api 服务。
#   留空则关闭反代，改用下面的 LANDRIVE_API_BASE_URL 跨域直连。
LANDRIVE_API_PROXY=api:8080

# 关闭反代时（LANDRIVE_API_PROXY 留空），浏览器直连的接口地址（要带 /api）。
# 例：https://api.example.com/api
# 开启反代时本项留空即可，前端会自动使用同源 /api。
LANDRIVE_API_BASE_URL=

# ─────────────── 端口（可选）───────────────

# 网页端对外端口（1Panel 反向代理指向这里）
WEB_PORT=80
# 接口对外端口（1Panel 反向代理指向这里）
API_PORT=8080

# ─────────────── 其它（可选）───────────────
# 反代时用于解析上游容器名。Docker 环境默认自动识别为内嵌 DNS（127.0.0.11），
# 一般无需设置；用自建 DNS 或特殊网络时才需要指定。
LANDRIVE_DNS_RESOLVER=

# 是否采信 X-Forwarded-For / X-Real-IP。经 1Panel 反向代理访问时应为 true：
# 后端据此识别真实客户端 IP（登录限流按 IP+工号 计数），并正确判断跨域来源。
LANDRIVE_TRUST_PROXY=true
# 管理员账号
LANDRIVE_ADMIN_EMPLOYEE_NO=admin
LANDRIVE_ADMIN_NAME=系统管理员
# 接口连通性探测超时（毫秒）
LANDRIVE_API_PROBE_TIMEOUT=6000
TZ=Asia/Shanghai
